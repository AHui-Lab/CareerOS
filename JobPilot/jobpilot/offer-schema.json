        },
        {
          "key": "monthly_base",
          "label": "已确认的转正固定月薪（税前）",
          "kind": "money",
          "help": "只填写每月保证发放的固定合计。月度绩效另记；只有平均年收入时，这里可以留空。"
        },
        {
          "key": "guaranteed_months",
          "label": "保证计薪月数 / 年",
          "kind": "number",
