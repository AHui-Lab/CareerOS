# JobPilot runs without AI. If these are blank it uses the local heuristic parser.
# Any OpenAI-compatible /chat/completions endpoint can be used.
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat

# Local server
JOBPILOT_HOST=127.0.0.1
JOBPILOT_PORT=8765

# CareerVault (optional but preferred resume source)
CAREERVAULT_URL=http://127.0.0.1:8766
