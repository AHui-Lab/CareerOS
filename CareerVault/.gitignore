.venv/
__pycache__/
*.py[cod]
.DS_Store
.env

# Sensitive local-only data
private/*
!private/.gitkeep

# Experience attachments are local by default. Opt in manually if you really want them in Git.
vault/experiences/*/attachments/

# Generated/cached data
cache/
*.tmp

# Generated resumes may contain personal information
vault/generated/*
!vault/generated/.gitkeep
